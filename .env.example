# ---- Production (docker-compose.prod.yml) ----
# Your domain; its DNS A record must point at the server. Caddy gets HTTPS for it.
DOMAIN=

# ---- Required ----
MONGODB_URI=mongodb://localhost:27017/staff_checkin
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/cleanup-photos
CRON_SECRET=change-me

# ---- Email (SMTP via Nodemailer) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- Check-in photos (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Face recognition ----
# CompreFace (free, self-hosted; see docker-compose.yml). Create a Recognition
# service in the CompreFace UI (http://localhost:8001) and paste its API key.
COMPREFACE_URL=http://localhost:8001
COMPREFACE_API_KEY=
# Similarity (0-1) required to accept a match
COMPREFACE_SIMILARITY_THRESHOLD=0.9
# "compreface" or "rekognition"; only needed if both are configured
FACE_RECOGNITION_PROVIDER=

# AWS Rekognition (paid alternative)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_REKOGNITION_COLLECTION_ID=staff-faces

# ---- Optional ----
# Timezone for organizations that have not set one (IANA name)
DEFAULT_TIMEZONE=UTC

# Used by `pnpm seed:super-admin`
SUPER_ADMIN_SEED_EMAIL=
SUPER_ADMIN_SEED_PASSWORD=
SUPER_ADMIN_SEED_FIRST_NAME=
SUPER_ADMIN_SEED_LAST_NAME=
